{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": "codigo-fonte/navegador",
    "outDir": "arquivos-publicos/js",
    "types": []
  },
  "include": ["codigo-fonte/navegador/**/*.ts"]
}
